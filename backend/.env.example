# Backend Environment Configuration template
# Copy to .env and adjust. NEVER commit .env (it is in .gitignore).

# --- Local LLM runtime (Ollama) ---
OLLAMA_URL=http://localhost:11434

# Primary model. Fallback if RAM/VRAM is tight: qwen2.5:1.5b-instruct
LLM_MODEL=qwen2.5:3b-instruct

# --- Retrieval models (Hugging Face, cached locally, never in Git) ---
EMBED_MODEL=intfloat/multilingual-e5-small
NLI_MODEL=cross-encoder/nli-deberta-base

# Model cache location, backend-relative. Stays inside E:\Desktop\ProofLens\data
HF_HOME=../data/models_cache

# --- Application ---
# Resolved relative to the backend working directory: ../data maps to
# E:\Desktop\ProofLens\data
DATA_DIR=../data
MAX_UPLOAD_MB=25
TOP_K=6

# --- Page-aware chunking ---
# Chunk size in characters and overlap between consecutive chunks on a page.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Hybrid retrieval ---
# Reciprocal Rank Fusion constant: score = sum(1 / (RRF_K + rank)).
RRF_K=60

# --- Evidence-grounded answering ---
# Evidence items retrieved per question, and the character budget for the
# evidence text sent to the model.
QA_TOP_K=5
QA_MAX_CONTEXT_CHARS=6000

# --- Citation verification (NLI) ---
# Softmax thresholds for entailment / contradiction. Not calibrated probabilities.
NLI_BATCH_SIZE=8
NLI_ENTAILMENT_THRESHOLD=0.60
NLI_CONTRADICTION_THRESHOLD=0.60
LLM_TIMEOUT_S=45

# --- API ---
CORS_ORIGINS=http://localhost:5173

# Evidence sufficiency / abstention (Phase 3.3)
EVIDENCE_MIN_RELEVANT_CHUNKS=1
EVIDENCE_MIN_SEMANTIC_SCORE=0.70
EVIDENCE_MAX_ITEMS=8
EVIDENCE_REQUIRE_VERIFICATION=true
EVIDENCE_CONSERVATIVE_MODE=false
